<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:itemTextAppearance">@style/MenuItemTextAppearance</item>
        <item name="android:windowActionBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionMenuTextColor">@color/colorSkyBlue</item>
        <item name="backgroundColor">@color/white</item>
        <item name="colorAccent">@color/colorSkyBlue</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
    </style>
    <style name="AppThemeDark" parent="@style/AppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="backgroundColor">@color/black_dark</item>
        <item name="colorAccent">@color/colorSkyBlue</item>
        <item name="colorPrimary">@color/black_dark</item>
        <item name="colorPrimaryDark">@color/black_dark</item>
    </style>
    <style name="Base.Theme.AppCompat" parent="@style/Base.V22.Theme.AppCompat" />
    <style name="Base.Theme.AppCompat.Light" parent="@style/Base.V22.Theme.AppCompat.Light" />
    <style name="SalatukAppTheme" parent="@style/Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">true</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_menu_home</item>
        <item name="android:colorAccent">@color/colorSkyBlue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorAccent">@color/colorSkyBlue</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
    </style>
    <style name="SettingsTheme" parent="@style/AppTheme">
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Base.V22.Theme.AppCompat" parent="@style/Base.V21.Theme.AppCompat">
        <item name="actionModeShareDrawable">?android:actionModeShareDrawable</item>
        <item name="editTextBackground">?android:editTextBackground</item>
    </style>
    <style name="Base.V22.Theme.AppCompat.Light" parent="@style/Base.V21.Theme.AppCompat.Light">
        <item name="actionModeShareDrawable">?android:actionModeShareDrawable</item>
        <item name="editTextBackground">?android:editTextBackground</item>
    </style>
</resources>
